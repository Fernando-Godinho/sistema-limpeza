# Copie este arquivo para .env antes de rodar na sua maquina:
#   cp .env.example .env

# Banco de dados local (SQLite). Para migrar para Postgres, troque a URL
# e o provider em prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar o cookie de sessao.
# Gere um valor longo e aleatorio, por exemplo com: openssl rand -base64 48
SESSION_SECRET="troque-este-segredo-por-uma-frase-longa-e-aleatoria"

# Pasta onde as fotos sao guardadas no disco.
# Deixe vazio para usar a pasta "storage" ao lado do projeto.
# Se preencher, use um caminho absoluto (ex.: /var/limpeza/storage).
STORAGE_DIR=

# Fuso horario usado para calcular o "dia de hoje" dos servicos.
TZ="America/Sao_Paulo"
